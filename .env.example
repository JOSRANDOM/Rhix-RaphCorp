# Postgres (Supabase) — usar el connection string del Transaction Pooler
DATABASE_URL=postgres://user:password@host:6543/postgres?sslmode=require

# Supabase Storage — bucket privado donde se guardan los XML/PDF recibidos.
# La service_role key es necesaria porque el worker sube archivos sin sesión
# de usuario (bypasea RLS) — nunca exponer esta key al frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=recibos

# IMAP del buzón dedicado (rhinbox@...)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=rhinbox@tudominio.com
IMAP_PASSWORD=

# Solo para cmd/api (Railway lo inyecta solo, no hace falta en producción)
PORT=8080

# Solo para cmd/api. Origen permitido para CORS (el dominio del frontend en
# producción). Si no se define, permite cualquier origen ("*") — está bien
# para local, pero en producción conviene fijarlo al dominio real.
CORS_ORIGIN=
